#!/system/bin/sh
# 猫猫 TProxy Plus v2 — Mihomo transparent proxy service for the ZTE F50 (Android, mksh + toybox).
# LAN TCP/UDP arriving on br0 is diverted with TPROXY; DNS stays with the F50 / AdGuard Home.
# Output lines starting with "@" are machine readable (key=value); errors start with "ERROR:".
SERVICE_VERSION=2.0.0
umask 077
export PATH="/system/bin:/system/xbin:/vendor/bin:$PATH"
BASE=/data/clash
PROXY=$BASE/Proxy
CORE=$PROXY/Clash.Core
CONFIG=$PROXY/config.yaml
SOURCE=$PROXY/source.yaml
# The core's home (-d): it may write here (cache.db, providers/), so nothing else lives in it.
# Geodata and the dashboard are immutable; config, source and the core binary stay outside.
HOME_DIR=$BASE/home
UI=$HOME_DIR/ui
GEOIP=$HOME_DIR/geoip.metadb
GEOSITE=$HOME_DIR/GeoSite.dat
ASN=$HOME_DIR/ASN.mmdb
SCRIPTS=$BASE/Scripts
SELF=$SCRIPTS/Clash.Service
NORMALIZER=$SCRIPTS/normalize.awk
SETTINGS=$BASE/settings.env
SUBS=$BASE/subs
STATE=$BASE/state
JOBS=$BASE/jobs
BACKUPS=$BASE/backups
LOG=$BASE/mihomo.log
PIDFILE=$BASE/mihomo.pid
IDENTITY=$BASE/mihomo.identity
TOKENFILE=$BASE/mihomo.session
WATCHPID=$BASE/mihomo-watch.pid
WATCHIDENTITY=$BASE/mihomo-watch.identity
OWNER=$BASE/tproxy.owner
OWNER_TAG=ufi-f50-tproxy-v1
LOCK=$BASE/service.lock
JOBLOCK=$BASE/jobs.lock
SECRET_FILE=$BASE/controller.secret
UPLOADS=/data/data/com.minikano.f50_sms/files/uploads
CURL=/data/data/com.minikano.f50_sms/files/curl
JQ=/data/data/com.minikano.f50_sms/files/jq
BOOT=/sdcard/ufi_tools_boot.sh
BOOT_TAG='# KANO_MM_TPROXY'
BOOT_LINE="/system/bin/sh $SELF boot >/dev/null 2>&1 </dev/null $BOOT_TAG"
CHAIN4=UFI_MM_TPROXY4
CHAIN6=UFI_MM_TPROXY6
DIVERT4=UFI_MM_DIVERT4
DIVERT6=UFI_MM_DIVERT6
GUARD4=UFI_MM_GUARD4
GUARD6=UFI_MM_GUARD6
MARK=0x20000000/0x20000000
TS_MARK=0x80000/0xff0000
TABLE=20251
PREF=1100
ROUTE_PROTO=186
LAN=br0
MIXED_PORT=7890
TPROXY_PORT=7893
CTRL_PORT=7788
PINNED_TAG=v1.19.32
PINNED_CORE_URL=https://github.com/MetaCubeX/mihomo/releases/download/v1.19.32/mihomo-android-arm64-v8-v1.19.32.gz
PINNED_CORE_SHA=42b1f2be8702484d3ae6238daab392622f54bd0d264966700f1f28f52596e326
PINNED_CORE_RAW_SHA=bb9afbd48717f92d59e07da35fb694b83d40d6edb63eb9033c2ee4174137d195
PINNED_GEO_URL=https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/d7fba95fbfc9eb82ec33b1762b3d7e11833eacd9/geoip.metadb
PINNED_GEO_SHA=d476395e4bd08275ca60af346d48fc40676e8aab382f04a07910215bb2fc2223
PINNED_XD_TAG=v1.273.1
PINNED_XD_URL=https://github.com/MetaCubeX/metacubexd/releases/download/v1.273.1/compressed-dist.tgz
PINNED_XD_SHA=a178e00b67acabcda2dcef00afa90be6a7bb261e466a67dad58c8478d9553603
MAX_SOURCE_BYTES=4194304
MAX_CORE_BYTES=134217728

# ---------------------------------------------------------------- helpers
# mksh (Android /system/bin/sh) has no printf builtin: every printf forks toybox (~18 ms on the F50).
# print is builtin, so hot paths use out/outn instead.
if [ -n "${KSH_VERSION:-}" ]; then
    out() { print -r -- "$*"; }
    outn() { print -nr -- "$*"; }
else
    out() { printf '%s\n' "$*"; }
    outn() { printf '%s' "$*"; }
fi
say() { out "$*"; }
kv() { out "@$1=$2"; }
log() { out "$(date '+%Y-%m-%d %H:%M:%S') [service] $*" >> "$LOG" 2>/dev/null; }
fail() { LAST_FAIL=$*; say "ERROR: $*"; log "ERROR: $*"; return 1; }
numeric() { case "$1" in ''|*[!0-9]*) return 1 ;; esac; }
# Decimal without leading zeros (mksh reads 010 as octal) and at most 9 digits (32-bit arithmetic).
num_in() {  # num_in <value> <min> <max>
    case "$1" in ''|*[!0-9]*|0?*) return 1 ;; esac
    [ "${#1}" -le 9 ] && [ "$1" -ge "$2" ] && [ "$1" -le "$3" ]
}
# Epoch seconds are already ten digits; compare their suffix without overflowing mksh integers.
epoch_ok() {
    case "$1" in ''|*[!0-9]*|0?*) return 1 ;; esac
    [ "${#1}" -le 9 ] && return 0
    [ "${#1}" = 10 ] || return 1
    case "$1" in
        1?????????) return 0 ;;
        2?????????) eo_tail=${1#2}; [ "$eo_tail" -le 147483647 ] ;;
        *) return 1 ;;
    esac
}
b64() { outn "$1" | base64 -w 0 2>/dev/null; }
NL='
'
if [ -n "${EPOCHREALTIME:-}" ]; then
    now() { outn "${EPOCHREALTIME%.*}"; }
    tick() { T_NOW=${EPOCHREALTIME%.*}; }
else
    now() { date +%s; }
    tick() { T_NOW=$(date +%s); }
fi
mono() { IFS=' ' read -r T_MONO _ < /proc/uptime; T_MONO=${T_MONO%.*}; }  # deadlines ignore clock steps
stamp() { date +%Y%m%d-%H%M%S; }
sha_of() { sha256sum "$1" 2>/dev/null | cut -d' ' -f1; }
fsize() { wc -c < "$1" 2>/dev/null | tr -d ' '; }

# Toybox timeout may report 0 although the child failed; read the child's own status.
mm_timeout() {
    mm_limit=$1
    shift
    mm_sequence=$(( ${mm_sequence:-0} + 1 ))
    mm_result="$STATE/.timeout.$$.$mm_sequence.rc"
    rm -f "$mm_result" || return 1
    if timeout -k 5 "$mm_limit" /system/bin/sh -c '
        result_file=$1
        shift
        "$@" &
        child=$!
        trap "kill -TERM \$child 2>/dev/null; sleep 1; kill -KILL \$child 2>/dev/null; exit 124" TERM
        wait "$child"
        child_status=$?
        printf "%s\n" "$child_status" > "$result_file" || exit 125
        exit "$child_status"
    ' mm_timeout "$mm_result" "$@"; then :; else :; fi
    if [ -s "$mm_result" ]; then
        IFS= read -r mm_status < "$mm_result" || mm_status=125
        rm -f "$mm_result"
        case "$mm_status" in ''|*[!0-9]*) return 125 ;; esac
        [ "$mm_status" -le 255 ] || return 125
        return "$mm_status"
    fi
    rm -f "$mm_result"
    return 124
}

# Builtin-only process identity: state and starttime (field 22) from /proc/<pid>/stat.
proc_stat() {
    ps_pid=$1
    ps_state=
    ps_start=
    numeric "$ps_pid" || return 1
    [ -r "/proc/$ps_pid/stat" ] || return 1
    IFS= read -r ps_line 2>/dev/null < "/proc/$ps_pid/stat" || return 1
    ps_rest=${ps_line##*) }
    set -f
    # shellcheck disable=SC2086
    set -- $ps_rest
    set +f
    ps_state=$1
    ps_start=${20}
    [ -n "$ps_start" ]
}

pid_matches() {
    numeric "$1" && numeric "$2" || return 1
    [ "$1" -gt 1 ] || return 1
    pm_want=$2
    proc_stat "$1" || return 1
    [ "$ps_start" = "$pm_want" ] && [ "$ps_state" != Z ] && [ "$ps_state" != X ]
}

core_matches() {
    pid_matches "$1" "$2" || return 1
    cm_exe=$(readlink "/proc/$1/exe" 2>/dev/null) || return 1
    [ "$cm_exe" = "$CORE" ] || [ "$cm_exe" = "$CORE (deleted)" ]
}

core_alive() {
    [ -r "$PIDFILE" ] && [ -r "$IDENTITY" ] || return 1
    IFS= read -r core_pid < "$PIDFILE" || return 1
    IFS=' ' read -r identity_pid core_start < "$IDENTITY" || return 1
    [ "$core_pid" = "$identity_pid" ] && core_matches "$core_pid" "$core_start"
}

# A hot reload cannot change -d. A process from the legacy layout must restart once on migration.
core_home_matches() {
    core_alive || return 1
    tr '\000' '\n' < "/proc/$core_pid/cmdline" | awk -v home="$HOME_DIR" '
        previous == "-d" && $0 == home { found = 1 }
        { previous = $0 }
        END { exit !found }
    '
}

watch_alive() {
    [ -r "$WATCHPID" ] && [ -r "$WATCHIDENTITY" ] || return 1
    IFS= read -r watch_pid < "$WATCHPID" || return 1
    IFS=' ' read -r identity_watch_pid watch_start < "$WATCHIDENTITY" || return 1
    [ "$watch_pid" = "$identity_watch_pid" ] && pid_matches "$watch_pid" "$watch_start"
}

ensure_dirs() {
    mkdir -p "$BASE" "$PROXY" "$SCRIPTS" "$BACKUPS" "$STATE" "$JOBS" "$SUBS" "$HOME_DIR" "$UI" || return 1
    chmod 700 "$BASE" "$PROXY" "$SCRIPTS" "$BACKUPS" "$STATE" "$JOBS" "$SUBS" "$HOME_DIR" "$UI" 2>/dev/null
    return 0
}

# Files delivered through the app's upload dir are owned by the app uid; make them root-only.
own() { chown 0:0 "$@" 2>/dev/null; chmod "${OWN_MODE:-600}" "$@" 2>/dev/null; return 0; }

lock_service() {  # lock_service <max-seconds>
    exec 9>"$LOCK"
    mono
    ls_end=$((T_MONO + ${1:-30}))
    while ! flock -n -x 9 9>&9; do
        mono
        [ "$T_MONO" -lt "$ls_end" ] || { exec 9>&-; return 1; }
        sleep 0.25
    done
}
unlock_service() { flock -u 9 9>&9 2>/dev/null; exec 9>&-; }

service_busy() {
    exec 7>"$LOCK"
    # Closing the only descriptor releases a lock we may have taken.
    if flock -n -x 7 7>&7; then exec 7>&-; return 1; fi
    exec 7>&-
    return 0
}

# The dashboard directory is served by the core and must not be writable by it: a subscription
# provider "path:" inside the core's home could otherwise plant HTML there. Immutable files cannot
# be written, renamed or created even by root.
protect_ui() { [ -d "$UI" ] && chattr -R +i "$UI" 2>/dev/null; return 0; }
unprotect_ui() { protections_open=1; [ -d "$UI" ] && chattr -R -i "$UI" 2>/dev/null; return 0; }
geo_lock() { for gl in "$GEOIP" "$GEOSITE" "$ASN"; do [ -f "$gl" ] && chattr +i "$gl" 2>/dev/null; done; return 0; }
geo_unlock() { protections_open=1; for gl in "$GEOIP" "$GEOSITE" "$ASN"; do [ -f "$gl" ] && chattr -i "$gl" 2>/dev/null; done; return 0; }

migrate_home() {  # Keep the legacy layout intact for rollback; geodata must use separate inodes.
    [ -d "$HOME_DIR" ] || { mkdir -p "$HOME_DIR" && chmod 700 "$HOME_DIR"; } || return 1
    for mh in geoip.metadb GeoSite.dat ASN.mmdb cache.db; do
        if [ -f "$PROXY/$mh" ] && [ ! -e "$HOME_DIR/$mh" ]; then
            if [ "$mh" = cache.db ]; then
                ln "$PROXY/$mh" "$HOME_DIR/$mh" 2>/dev/null || cp -p "$PROXY/$mh" "$HOME_DIR/$mh" || return 1
            else
                cp -p "$PROXY/$mh" "$HOME_DIR/$mh" || return 1
            fi
        fi
    done
    if [ ! -s "$UI/index.html" ] && [ -s "$PROXY/ui/index.html" ]; then
        mkdir -p "$UI" && cp -p "$PROXY/ui/index.html" "$UI/index.html" && own "$UI/index.html" || return 1
    fi
    return 0
}

# ---------------------------------------------------------------- settings
setting_ok() {
    so_v=$2
    case "$1" in
        MM_GUARD_TS|MM_IPV6|MM_UDP|MM_QUIC_BLOCK|MM_SNIFF|MM_AUTO_RESTART)
            case "$so_v" in 0|1) return 0 ;; esac; return 1 ;;
        MM_DEV_MODE) case "$so_v" in all|bypass|only) return 0 ;; esac; return 1 ;;
        MM_DEV_LIST) dev_list_ok "$so_v"; return ;;
        MM_BYPASS_PORTS) port_list_ok "$so_v"; return ;;
        MM_MODE) case "$so_v" in rule|global|direct) return 0 ;; esac; return 1 ;;
        MM_LOG_LEVEL) case "$so_v" in silent|error|warning|info|debug) return 0 ;; esac; return 1 ;;
        MM_LOG_MAX_KB) num_in "$so_v" 128 16384; return ;;
        MM_SUB_ACTIVE) [ -z "$so_v" ] || sub_id_ok "$so_v"; return ;;
        MM_SUB_INTERVAL) case "$so_v" in 0|6|12|24|48|72) return 0 ;; esac; return 1 ;;
        MM_SUB_UA)
            [ -n "$so_v" ] && [ "${#so_v}" -le 64 ] || return 1
            case "$so_v" in *[!A-Za-z0-9._/\(\)+\ -]*) return 1 ;; esac; return 0 ;;
        MM_DL_VIA) case "$so_v" in auto|direct|proxy) return 0 ;; esac; return 1 ;;
        MM_GH_MIRROR)
            [ -z "$so_v" ] && return 0
            [ "${#so_v}" -le 120 ] || return 1
            case "$so_v" in https://?*/) ;; *) return 1 ;; esac
            case "$so_v" in *[!A-Za-z0-9._~:/?#@%=+-]*) return 1 ;; esac; return 0 ;;
        MM_DNS) dns_list_ok "$so_v"; return ;;
        MM_MEMLIMIT) [ "$so_v" = 0 ] || num_in "$so_v" 64 512; return ;;
    esac
    return 1
}

SETTING_KEYS='MM_GUARD_TS MM_IPV6 MM_UDP MM_QUIC_BLOCK MM_SNIFF MM_AUTO_RESTART MM_DEV_MODE MM_DEV_LIST MM_BYPASS_PORTS MM_MODE MM_LOG_LEVEL MM_LOG_MAX_KB MM_SUB_ACTIVE MM_SUB_INTERVAL MM_SUB_UA MM_DL_VIA MM_GH_MIRROR MM_DNS MM_MEMLIMIT'

settings_defaults() {
    MM_GUARD_TS=1; MM_IPV6=1; MM_UDP=1; MM_QUIC_BLOCK=0; MM_SNIFF=1; MM_AUTO_RESTART=1
    MM_DEV_MODE=all; MM_DEV_LIST=; MM_BYPASS_PORTS=123,853; MM_MODE=rule; MM_LOG_LEVEL=warning
    MM_LOG_MAX_KB=1024; MM_SUB_ACTIVE=; MM_SUB_INTERVAL=0; MM_SUB_UA=clash.meta; MM_DL_VIA=auto
    MM_GH_MIRROR=; MM_DNS=223.5.5.5,119.29.29.29; MM_MEMLIMIT=128
}

# Never sourced: every key is matched against the fixed list and every value validated.
load_settings() {
    settings_defaults
    [ -r "$SETTINGS" ] || return 0
    while IFS= read -r ls_kv || [ -n "$ls_kv" ]; do
        ls_k=${ls_kv%%=*}
        ls_v=${ls_kv#*=}
        [ "$ls_k" = "$ls_kv" ] && continue
        case " $SETTING_KEYS " in *" $ls_k "*) ;; *) continue ;; esac
        setting_ok "$ls_k" "$ls_v" && eval "$ls_k=\$ls_v"
    done < "$SETTINGS"
    return 0
}

write_settings() {
    ws_tmp=$SETTINGS.tmp.$$
    : > "$ws_tmp" || return 1
    for ws_k in $SETTING_KEYS; do
        eval "ws_v=\$$ws_k"
        printf '%s=%s\n' "$ws_k" "$ws_v" >> "$ws_tmp" || { rm -f "$ws_tmp"; return 1; }
    done
    own "$ws_tmp"
    mv -f "$ws_tmp" "$SETTINGS"
}

set_setting() { setting_ok "$1" "$2" || return 1; eval "$1=\$2"; }

sub_id_ok() { case "$1" in ''|*[!a-z0-9]*) return 1 ;; esac; [ "${#1}" -le 16 ]; }

ipv4_ok() {
    i4=$1
    case "$i4" in ''|*[!0-9.]*) return 1 ;; esac
    IFS=.
    set -f
    # shellcheck disable=SC2086
    set -- $i4
    set +f
    unset IFS
    [ "$#" = 4 ] || return 1
    for i4o in "$@"; do
        [ "$i4o" = 0 ] || num_in "$i4o" 1 255 || return 1
    done
}

dev_item_ok() {
    case "$1" in
        [0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]) return 0 ;;
        */*) ipv4_ok "${1%/*}" && num_in "${1#*/}" 8 32; return ;;
        *) ipv4_ok "$1"; return ;;
    esac
}

dev_list_ok() {
    [ -z "$1" ] && return 0
    [ "${#1}" -le 1400 ] || return 1
    IFS=,
    set -f
    # shellcheck disable=SC2086
    set -- $1
    set +f
    unset IFS
    [ "$#" -le 64 ] || return 1
    for dl_item in "$@"; do dev_item_ok "$dl_item" || return 1; done
}

port_list_ok() {
    [ -z "$1" ] && return 0
    IFS=,
    set -f
    # shellcheck disable=SC2086
    set -- $1
    set +f
    unset IFS
    [ "$#" -le 16 ] || return 1
    for pl_port in "$@"; do
        num_in "$pl_port" 1 65535 || return 1
        case "$pl_port" in 53|"$MIXED_PORT"|"$TPROXY_PORT"|"$CTRL_PORT") return 1 ;; esac
    done
}

ipv6_ok() {
    case "$1" in ''|*[!0-9A-Fa-f:]*|*:::*) return 1 ;; esac
    i6_after=${1#*::}
    if [ "$i6_after" != "$1" ]; then case "$i6_after" in *::*) return 1 ;; esac; fi
    IFS=:
    set -f
    # shellcheck disable=SC2086
    set -- $1
    set +f
    unset IFS
    [ "$#" -le 8 ] || return 1
    for i6_g in "$@"; do [ "${#i6_g}" -le 4 ] || return 1; done
}

dns_host_ok() {  # host, host:port, [v6] or [v6]:port
    dh=$1
    case "$dh" in
        \[*)
            dh_v6=${dh#\[}
            dh_rest=${dh_v6#*\]}
            [ "$dh_rest" != "$dh_v6" ] || return 1
            dh_v6=${dh_v6%%\]*}
            ipv6_ok "$dh_v6" || return 1
            case "$dh_rest" in '') return 0 ;; :*) num_in "${dh_rest#:}" 1 65535; return ;; *) return 1 ;; esac ;;
        *:*:*) return 1 ;;
        *:*) num_in "${dh##*:}" 1 65535 || return 1; dh=${dh%:*} ;;
    esac
    case "$dh" in ''|*[!A-Za-z0-9.-]*|.*|-*) return 1 ;; esac
    return 0
}

dns_list_ok() {
    [ -n "$1" ] && [ "${#1}" -le 400 ] || return 1
    IFS=,
    set -f
    # shellcheck disable=SC2086
    set -- $1
    set +f
    unset IFS
    [ "$#" -ge 1 ] && [ "$#" -le 4 ] || return 1
    for dn_item in "$@"; do
        case "$dn_item" in
            https://*)
                dn_rest=${dn_item#https://}
                dn_host=${dn_rest%%/*}
                dn_path=${dn_rest#"$dn_host"}
                dns_host_ok "$dn_host" || return 1
                case "$dn_path" in *[!A-Za-z0-9._~/?=\&%+-]*) return 1 ;; esac ;;
            tls://*|quic://*) dns_host_ok "${dn_item#*://}" || return 1 ;;
            *:*) ipv6_ok "$dn_item" || return 1 ;;
            *) ipv4_ok "$dn_item" || return 1 ;;
        esac
    done
}

# ---------------------------------------------------------------- secret / config generation
ensure_secret() {
    if [ -r "$SECRET_FILE" ]; then
        IFS= read -r es_v < "$SECRET_FILE"
        case "$es_v" in *[!a-f0-9]*|'') ;; *) [ "${#es_v}" = 48 ] && { SECRET=$es_v; return 0; } ;; esac
    fi
    es_v=$(od -An -N24 -tx1 /dev/urandom | tr -d ' \n')
    case "$es_v" in *[!a-f0-9]*|'') return 1 ;; esac
    [ "${#es_v}" = 48 ] || return 1
    printf '%s\n' "$es_v" > "$SECRET_FILE.tmp.$$" && own "$SECRET_FILE.tmp.$$" && mv -f "$SECRET_FILE.tmp.$$" "$SECRET_FILE" || return 1
    SECRET=$es_v
}

yaml_flow_list() {  # comma separated, already validated -> ["a", "b"]
    yf_out=
    IFS=,
    set -f
    # shellcheck disable=SC2086
    set -- $1
    set +f
    unset IFS
    for yf_item in "$@"; do yf_out="$yf_out${yf_out:+, }\"$yf_item\""; done
    outn "[$yf_out]"
}

bool() { if [ "$1" = 1 ]; then outn true; else outn false; fi; }

lan_allowed() {  # sources allowed on the mixed (HTTP/SOCKS) port: loopback, LAN, Tailscale
    la_list='"127.0.0.0/8", "::1/128", "100.64.0.0/10", "fd7a:115c:a1e0::/48", "fe80::/10", "fc00::/7"'
    la_v4=$(ip -4 -o addr show dev "$LAN" 2>/dev/null | awk '{print $4}')
    la_v6=$(ip -6 -o addr show dev "$LAN" scope global 2>/dev/null | awk '{print $4}')
    [ -n "$la_v4" ] || la_v4=192.168.0.0/16
    for la in $la_v4 $la_v6; do
        case "$la" in ''|*[!0-9A-Fa-f:./]*) continue ;; esac
        la_list="$la_list, \"$la\""
    done
    outn "[$la_list]"
}

